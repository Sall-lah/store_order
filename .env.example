# Server Configuration
PORT=8060
GRPC_PORT=50051
DEV=true
ENABLE_DOCS=true

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/store_order?schema=public

# Apache Kafka Configuration (Transactional Outbox Publisher & Consumer)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_USER_EVENTS=user.events
KAFKA_USER_EVENTS_GROUP_ID=store_order_user_events

# Product Microservice Integration URL
PRODUCT_SERVICE_URL=http://localhost:8040

# Midtrans Payment Gateway Configuration (Snap Integration)
MIDTRANS_SERVER_KEY=SB-Mid-server-sample-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-sample-key
MIDTRANS_IS_PRODUCTION=false

# Redis Distributed Rate Limiter Configuration
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_RATE_LIMIT_ENABLED=true
